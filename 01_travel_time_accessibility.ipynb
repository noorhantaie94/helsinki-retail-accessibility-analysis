   "source": [
    "# Data integrity check: Verify spatial dataset type\n",
    "import geopandas\n",
    "assert isinstance(grid, geopandas.GeoDataFrame), \"Output object must be a GeoDataFrame.\"\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data integrity check: Confirm presence of joined attribute columns\n",
    "required_columns = ['pt_r_t_Itis', 'car_r_t_Itis', 'pt_r_t_Myyrmanni', 'car_r_t_Myyrmanni', 'geometry']\n",
    "assert all(column in grid.columns for column in required_columns), \"Missing required spatial attributes in joined GeoDataFrame.\"\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data integrity check: Verify elimination of NoData (-1) values\n",
    "for shopping_centre in (\"Itis\", \"Myyrmanni\"):\n",
    "    for column in (\"car_r_t\", \"pt_r_t\"):\n",
    "        assert -1 not in grid[f\"{column}_{shopping_centre}\"], \"NoData values (-1) remain in attribute table.\"\n"
   ]
  },
