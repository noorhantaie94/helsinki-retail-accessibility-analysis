    "source": [
      "### Travel Time Classification (5-Minute Intervals)\n",
      "Classified accessibility data for public transit and private vehicles into 13 travel-time classes using `mapclassify.UserDefined` (5-minute threshold breaks from 5 to 60 minutes).\n"
    ]   ]
  },
